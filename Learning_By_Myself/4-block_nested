#include <iostream>
using namespace std;

int main()
{
    int val{};
    cin >> val;

    if(val >=0) //positive number
    {
        if(val %2 == 0)
        {
            cout << "The number is positive and even\n";
        }
        else
        {
            cout << "The number is positive and odd\n";
        }
    }
}
