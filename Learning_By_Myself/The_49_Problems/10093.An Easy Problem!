#include<iostream>
#include<string>
#include<algorithm>
using namespace std;


int main()
{
 string R;

  while(cin >> R)
{
    // store the sum of the digits of the given num
   int sum =0;
   int max_digit = 0; // remember the largest digit value

   // we have to read each charater in R. It helps we there is letter and need to convert it to integer regarding to the ASCII
   
  for(int i=0; i< R.length(); i++)
{
     int value;
   if(R[i] >= '0' && R[i] <= '9'){ value = R[i] - '0';}
   else if(R[i] >= 'A' && R[i] <= 'Z'){ value = R[i]- 'A' +10;}
  else{ value = R[i] -'a' +36;}

  // calcuclate the sum and the largest
 sum += value;
    if(value > max_digit){ max_digit = value; }

}
  int min_base= max(2, max_digit + 1);

  //test every base

  bool found = false;// since we have not found a valid base yet

for(int base= min_base; base <= 62; base++)
{
  if(sum % (base -1) ==0) {cout << base << '\n'; 
  found = true;
   break;}
}
   if(!found){cout <<"such number is impossible!" << '\n';}
}

}
