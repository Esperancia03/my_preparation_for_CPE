#include<iostream>
#include<string>
#include<cctype>
#include<algorithm>
using namespace std;

int main()
{
    int lines;
    cin >> lines;
    cin.ignore();

    int count[26] = {0};
    char letters[26];
    
    for(int i=0; i< 26; i++)
    {
        letters[i] = 'A' + i;
    }

    for(int n=0; n< lines; n++)
    {
        string text;
        getline(cin, text);

        for(int i=0; i<text.size(); i++)
        {
           
           if(isalpha(text[i]))
           {
            char up = toupper(text[i]);
            count[up - 'A']++;
           }
            
        }
        }

        //now sort from bigger count to smaller
        for(int i=0; i< 26; i++)
        {
          for(int j=i+1; j< 26; j++)
          {
            if(count[j] > count[i])
            {
                swap(count[i], count[j]);
                swap(letters[i], letters[j]);
            }
            else if(count[j] == count [i])
            {
                if(letters[j] < letters[i])
                {
                    swap(count[j], count[i]);
                    swap(letters[j], letters[i]);
                }
            }
          }
        }
          for(int i=0; i< 26; i++)
          {
            if(count[i] >0)
            {
                cout << letters[i] << " " << count[i] << '\n';
            } 
          }
        
       

    
    return 0;

}
