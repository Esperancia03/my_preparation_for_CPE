#include <iomanip>
#include<iostream>


using namespace std;

void bangla_num(long long n)
{
    if(n >=10000000)
    {
      bangla_num( n/10000000);
      cout  << " kuti";
      n %=10000000;
    }
     if(n>=100000)
    {
      bangla_num( n/100000);
        cout << " lakh";
        n %=100000;
    }
    
      if(n>=1000)
    {
         bangla_num( n/1000);
        cout  << " hajar";
        n %=1000;
    }
      if(n>=100)
    {
        bangla_num( n/100);
        cout  << " shata";
        n %=100;
    }

    if(n>0)
    {
        cout << " "<< n;
    }
}


int main()

{

    long long a;
     int caseNo =1;


    while(cin>>a)
    {
        cout << setw(4) << caseNo << ".";

        if(a==0)
        {
            cout << " 0" << '\n';

        }
        else
        {
            bangla_num(a);
            cout << '\n';
        }
        caseNo++;
    }
}
