#include<iostream>
#include<cstdlib>
using namespace std;


// we need long long because 0 ≤ each_integer ≤ 100000
long long Steps(long long x, long long y)
{
  long long n = x +y;
  return n * (n+1)/2 +x;
}

int main()
{
int tests;
cin >> tests;
 for(int i=1; i<= tests; i++)
 {
   long long x1, x2, y1, y2;
   cin >> x1 >> y1 >> x2 >> y2;
   
   long long distance = abs(Steps(x2, y2) - Steps(x1, y1));
    cout << "Case " << i << ": " << distance << '\n';

 }
 

}
