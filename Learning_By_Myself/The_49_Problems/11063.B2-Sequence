#include<iostream>
#include<vector>
#include<set>
using namespace std;


int main()
{
  int N;
   
int Case_No =1;
  while(cin>> N)
{
vector <int> numbers(N);
set<int> sums;
bool is_B2 = true;

for(int i=0; i< N; i++){
   cin >> numbers[i];

          
//starting from 1, and a message indicating if the corresponding sequence it is a B2-Sequence or not.
if(numbers[i] <=0) {is_B2 = false;}
if(i> 0 && numbers[i] <= numbers[i-1]) {is_B2 = false;}


    
}
 for(int j=0; j<numbers.size(); j++)
{
      for(int k=j; k<numbers.size(); k++)
{    
        int sum = numbers[j] + numbers[k];

    if(sums.count(sum) > 0)
    {
      is_B2 = false;
    }
   else{
     sums.insert(sum);
   }

 }

}
 if(is_B2)
{
   cout <<"Case #" << Case_No << ": "<<  "It is a B2-Sequence." << '\n';

}
else{
 cout <<"Case #" << Case_No << ": "<<  "It is not a B2-Sequence." << '\n';
}
Case_No++;
}
}
