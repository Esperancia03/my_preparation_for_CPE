#include<iostream>
#include<cmath>
#include<vector>
using namespace std;


int main()
{
    int tests, num;
    cin >> tests;
   
    for(int case_num=1; case_num<=tests; case_num++)
    {

     cin >> num;
     int original_num = num;
    vector<int> seen;


    while(num !=1)
    {
       bool repeated= false;
       

       for(int i=0; i<seen.size(); i++)
       {
        if(seen[i]==num)
         {repeated = true;
        break;
         }
       }
       if(repeated) break;
       seen.push_back(num);
    
    
    int sum_square=0;

    while(num)
    {
        int digit = num%10;
    
        sum_square += digit * digit;  
        num /=10;
       
    }
    num=sum_square;


}
    if(num !=1)
    {
        cout << "Case #" << case_num <<": " << original_num << " is an Unhappy number." << '\n';
    }
    else
    {
        cout<< "Case #" << case_num<< ": " << original_num  << " is a Happy number." << '\n';
    }
    
}
    }

