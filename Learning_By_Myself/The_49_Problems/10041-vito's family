#include<iostream>
#include<algorithm>
#include<cstdlib>
#include<vector>
using namespace std;

int main()
{
   int test_case, relatives;

   cin >> test_case;

for(int i=0; i< test_case; i++)
{
    cin >> relatives;
    vector<int> streets(relatives);
      //now that we have the input of the number of relatives now let's display their relative street

    for(int j=0; j< relatives; j++)
      {
        cin >> streets[j];
       
      }
      sort(streets.begin(), streets.end());

         // now let's find the median
      int med = streets[relatives/2];
      int distance=0;
         for(int j=0; j< relatives; j++)
      {
         distance += abs(streets[j]-med);
      }
       cout << distance << '\n';   

}


}
