#include<iostream>
#include<vector>
#include<cmath>
using namespace std;

int main()
{
    vector<int> nums(3);
   int sum{};
   int product{1};
  
 cout<< "Enter 3 integers: " ;

  for(int i=0; i<3; ++i)
  {
    cin >> nums[i];
    sum += (nums[i]);
    product *= (nums[i]);
  }

 
  cout << "The sum is: " << sum << '\n';
  cout << "The product is: " << product <<'\n';

}
