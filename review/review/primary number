#include<iostream>
using namespace std;

int main()
{
int a, b;
while(cin >> a >> b)
{
  if(a==0 && b == 0)break;
int count =0;
  int carry=0;
while(a >0 || b>0){
 int digitA = a %10;
int digitB= b %10;
  if(digitA + digitB + carry >=10){
     carry=1;
    count++;
  }
 a/=10;
 b/=10;
}
if(count == 0){ cout << "No carry operation." << endl;}
if(count == 1){ cout << "1 carry operation." << endl;}
else{cout << "3 carry operations." << endl;}


}
}
