#include<iostream>
#include<string>
#include<cctype>
#include<algorithm>
using namespace std;

int main()
{
  //The first line of input contains a single positive decimal integer n.
 int n;
 cin >> n;
 cin.ignore();
 int count[26] = {0};
char letters[26];

  for(int i=0; i<26; i++)
    {
      letters[i] = 'A' + i;
    }

for(int j=0; j<n; j++)
{
      string text;
      getline(cin, text);
   for(int i=0; i< text.size; i++)
    {
     if(isalpha(i)) 
{
    char up = toupper(text[i]);
    count[up - 'A']++;
}
    }
}

//sort
for(int i=0; i<26; i++)
{
 for(int j=i+1; j<26; j++)
{
 if(count[j] > count[i]) {swap(count[j], count[i]);
  swap(letters[j], letters[i]);
}
else if(count[j] == count[i]){
  if(letters[j] < letters[i]){ swap(count[j], count[i]);
swap(letters[j], letters[i]);}
}
}


}
for(int i=0; i< 26; i++)
{
if(count[i] >0)
{
cout <<letters[i] << " " << count[i] << '\n';
}
}
}
