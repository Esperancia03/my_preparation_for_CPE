#include<iostream>
#include<algorithm>
using namespace std;

int cycle_length(int n)
{
 int count=1;
while(n !=1)
{
 count++;
  if(n % 2==0)
  {
   n /=2;
  }
  else{
  n = 3 * n +1;
  }
 }
  return count;

}

